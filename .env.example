# InsightScope — local development configuration
# Copy to .env (git-ignored) and adjust as needed. Never commit real secrets.

# MongoDB connection (backend + seed)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=insightscope

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Frontend: base URL of the FastAPI backend (baked at build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: test database URI used by backend integration tests
# MONGODB_TEST_URI=mongodb://localhost:27017
